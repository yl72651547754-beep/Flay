<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 
        مستشعر التسارع (Accelerometer) لا يتطلب إذناً خطيراً في أندرويد (لا يحتاج runtime permission)،
        ولكن نصرّح باستخدام ميزة المستشعر للتأكد من توافق الجهاز وإمكانية تثبيت التطبيق.
        Note: The Accelerometer sensor does not require runtime permissions on Android,
        but declaring the hardware feature specifies device compatibility.
    -->
    <uses-feature
        android:name="android.hardware.sensor.accelerometer"
        android:required="false" />

    <!-- 
        إذن الاهتزاز (Vibration) لتقديم تغذية راجعة لمسية خفيفة (Haptic Feedback) 
        للطفل عند تغيير لون الكأس أو التقاط الكرات.
        Permission for haptic feedback when cup changes color.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
